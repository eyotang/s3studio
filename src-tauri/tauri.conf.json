{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "S3 Studio",
  "version": "0.2.3",
  "identifier": "com.s3studio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "S3 Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#fafafb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "跨平台 S3 文件工作空间",
    "category": "Utility"
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3NkVEODAyRkNCMDQ0N0IKUldSN1JMRDhBdGh1RjJFckJnWVZvdU9nN01IVGljRVVRVDQwRlEyK05tRzVFS0NudEF6UDRLa3EK",
      "endpoints": [
        "https://github.com/eyotang/s3studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
